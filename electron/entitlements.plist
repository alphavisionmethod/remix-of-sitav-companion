<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ════════════════════════════════════════════════════════════════
  SITA OS — macOS Hardened Runtime Entitlements
  Used by electron/forge.config.cjs osxSign block.
  Minimum entitlements for sandboxed Electron app with notarization.
  ════════════════════════════════════════════════════════════════
-->
<plist version="1.0">
<dict>
  <!-- Required for Electron's V8 JIT under hardened runtime -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Required for native modules / dyld loading -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Network access (Supabase, OTA, AI gateway) -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>

  <!-- File-system access via fs-bridge.cjs (dialog-gated) -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <key>com.apple.security.files.downloads.read-write</key>
  <true/>

  <!-- Notifications (send-notification IPC channel) -->
  <key>com.apple.security.personal-information.calendars</key>
  <false/>
</dict>
</plist>
