# ═══════════════════════════════════════════════════════════════════════
# SITA OS — Runtime Shell Service
# Launches the SITA Electron desktop shell after first-boot completes.
# ═══════════════════════════════════════════════════════════════════════
[Unit]
Description=SITA OS Desktop Shell
Documentation=https://sita.dev/docs/runtime
After=multi-user.target sita-firstboot.service network-online.target
Wants=network-online.target
Requires=sita-firstboot.service
ConditionPathExists=/var/lib/sita/.first-boot-complete

[Service]
Type=simple
User=sita
Group=sita
PAMName=login
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=NODE_ENV=production
Environment=SITA_RUNTIME_MODE=desktop
WorkingDirectory=/opt/sita/shell

# Start X server then hand off to the canonical shell launcher
# (launch.sh → shell-watchdog.sh → /usr/bin/sita-shell)
ExecStartPre=/usr/bin/install -d -m 0700 -o sita -g sita /run/user/1000
ExecStart=/usr/bin/xinit /opt/sita/shell/launch.sh -- :0 vt7 -nolisten tcp
ExecStartPost=/bin/sh -c 'sleep 5 && /opt/sita/runtime/check-shell-health.sh || true'

# Crash policy: systemd handles burst rate; shell-watchdog escalates to
# safe-mode and then to sita-recovery-shell.service on repeated failures.
Restart=on-failure
RestartSec=3
StartLimitIntervalSec=120
StartLimitBurst=5
TimeoutStartSec=60
OnFailure=sita-recovery-shell.service

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sita /var/log/sita /home/sita /run/user/1000
ProtectHome=false
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sita-runtime

[Install]
WantedBy=graphical.target
