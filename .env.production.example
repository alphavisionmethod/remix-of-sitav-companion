# ═══ SITA OS — Production Environment Variables ═══
# Copy to .env and fill in values before building.
# All VITE_* variables are embedded at build time.

# ── Supabase (Required) ──────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# ── Push Notifications (Required for web push) ───────
# Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
# Private key is stored as a Supabase secret, not here

# ── Build Metadata (Optional) ────────────────────────
BUILD_VERSION=1.0.0
BUILD_DATE=2026-04-09

# ═══ Runtime Secrets (set in Supabase Dashboard → Edge Function Secrets) ═══
# These are NOT build-time vars — they live in Supabase secrets.
#
# VAPID_PRIVATE_KEY       — Web push signing key
# VAPID_SUBJECT           — mailto: URI for push contact
# OPENAI_API_KEY          — AI gateway fallback
# ANTHROPIC_API_KEY       — AI gateway fallback
# TWILIO_ACCOUNT_SID      — SMS/voice notifications
# TWILIO_AUTH_TOKEN        — SMS/voice auth
# TWILIO_PHONE_NUMBER     — Outbound SMS number
# SUPABASE_SERVICE_ROLE_KEY — Admin operations (auto-set)
# SUPABASE_DB_URL         — Direct DB access (auto-set)

# ═══ Self-Hosted / Docker Only ═══════════════════════
# ACME_EMAIL=admin@yourdomain.com       — Traefik TLS cert registration
# SITA_UPDATE_URL=https://releases.sita.os — OTA update server
# SITA_UPDATE_CHANNEL=stable             — Release channel (stable/beta/canary)
# POSTGRES_PASSWORD=change-me            — Local Postgres password
# JWT_SECRET=change-me-to-random-string  — Supabase JWT signing secret
