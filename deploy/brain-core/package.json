{
  "name": "sita-brain-core",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "npx tsx --watch server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "npx eslint server.ts",
    "clean": "rm -rf dist",
    "health-check": "curl -sf http://localhost:3001/health || exit 1",
    "ready-check": "curl -sf http://localhost:3001/ready || exit 1"
  },
  "dependencies": {
    "hono": "^4.4.0",
    "@hono/node-server": "^2.1.4",
    "@supabase/supabase-js": "^2.101.1",
    "nats": "^2.28.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/node": "^22.16.5"
  }
}
