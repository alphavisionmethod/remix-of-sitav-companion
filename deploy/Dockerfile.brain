# ── SITA OS — Brain Core Container ──
FROM node:20-alpine AS builder
WORKDIR /app
COPY deploy/brain-core/package.json deploy/brain-core/package-lock.json* ./
RUN npm ci
COPY deploy/brain-core/ ./
RUN npx tsc

FROM node:20-alpine AS runner
WORKDIR /app
COPY --from=builder /app/package.json ./
RUN npm ci --omit=dev
COPY --from=builder /app/dist/ ./dist/
ENV NODE_ENV=production
EXPOSE 3001
CMD ["node", "dist/server.js"]
