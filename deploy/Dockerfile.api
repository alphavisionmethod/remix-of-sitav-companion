# ── SITA OS — API Gateway Container ──
# Build context: project root (docker-compose context: .)
FROM node:20-alpine AS builder
WORKDIR /app

# Install deps
COPY deploy/api-gateway/package.json ./package.json
RUN npm install

# Copy source and compile
COPY deploy/api-gateway/tsconfig.json ./tsconfig.json
COPY deploy/api-gateway/server.ts ./server.ts
RUN npx tsc

FROM node:20-alpine AS runner
WORKDIR /app
RUN addgroup -g 1001 -S sita && adduser -S sita -u 1001 -G sita
COPY --from=builder /app/package.json ./
RUN npm install --omit=dev
COPY --from=builder /app/dist/ ./dist/

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget --spider -q http://localhost:3000/health || exit 1

ENV NODE_ENV=production
EXPOSE 3000
USER sita
CMD ["node", "dist/server.js"]
