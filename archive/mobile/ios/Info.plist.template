<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SITA OS — Info.plist template
  Merged into ios/App/App/Info.plist by Capacitor at sync time.
  All NS*UsageDescription strings MUST be present per App Store Review §5.1.1.
-->
<plist version="1.0">
<dict>
  <key>CFBundleDisplayName</key>
  <string>SITA OS</string>
  <key>CFBundleIdentifier</key>
  <string>com.sita.os</string>
  <key>CFBundleShortVersionString</key>
  <string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key>
  <string>$(CURRENT_PROJECT_VERSION)</string>

  <!-- Privacy usage strings (required) -->
  <key>NSCameraUsageDescription</key>
  <string>SITA OS uses the camera to scan documents into your encrypted vault and capture context for advisors.</string>
  <key>NSPhotoLibraryUsageDescription</key>
  <string>SITA OS accesses your photo library so you can add documents to your vault.</string>
  <key>NSFaceIDUsageDescription</key>
  <string>SITA OS uses Face ID to unlock your vault and authorize sensitive advisor actions.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>SITA OS uses the microphone for voice queries with your concierge.</string>
  <key>NSContactsUsageDescription</key>
  <string>SITA OS optionally maps your contacts to your relationship graph (off by default).</string>
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>SITA OS uses location only for travel-aware advisor context (off by default).</string>
  <key>NSUserTrackingUsageDescription</key>
  <string>SITA OS does not track you across apps.</string>

  <!-- Background modes -->
  <key>UIBackgroundModes</key>
  <array>
    <string>fetch</string>
    <string>remote-notification</string>
  </array>

  <!-- App transport security: enforce TLS -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <false/>
  </dict>

  <!-- URL scheme for deep links -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.sita.os</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>sita</string>
      </array>
    </dict>
  </array>

  <!-- Required device capabilities -->
  <key>UIRequiredDeviceCapabilities</key>
  <array>
    <string>arm64</string>
  </array>
  <key>MinimumOSVersion</key>
  <string>16.0</string>
</dict>
</plist>
