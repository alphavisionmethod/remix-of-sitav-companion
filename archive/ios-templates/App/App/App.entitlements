<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ════════════════════════════════════════════════════════════
	     APNs / Push notifications
	     DEFERRED until Apple Developer Program membership is funded.
	     Uncomment the next two lines to enable APNs in production.
	     ════════════════════════════════════════════════════════════ -->
	<!--
	<key>aps-environment</key>
	<string>production</string>
	-->

	<!-- Keychain access groups — used by native-secure-storage.ts -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)app.lovable.sita-os.secure</string>
	</array>

	<!-- Universal links — sita:// + https://*.lovable.app deep links -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:e245cf40-61cc-4143-bfa4-f97382e8d62d.lovable.app</string>
		<string>applinks:e245cf40-61cc-4143-bfa4-f97382e8d62d.lovableproject.com</string>
	</array>

	<!-- App Attest — device attestation for trust receipts -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
</dict>
</plist>
