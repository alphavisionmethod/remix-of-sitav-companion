<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>SITA OS</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>16.0</string>

	<!-- Launch + UI -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>

	<!-- Background modes (push deferred; remote-notification active for future) -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
		<string>remote-notification</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>app.lovable.sita-os.refresh</string>
	</array>

	<!-- Networking — App Transport Security: HTTPS only, no exceptions -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>

	<!-- App-bound domains (mirrors capacitor.config.ts limitsNavigationsToAppBoundDomains) -->
	<key>WKAppBoundDomains</key>
	<array>
		<string>e245cf40-61cc-4143-bfa4-f97382e8d62d.lovable.app</string>
		<string>e245cf40-61cc-4143-bfa4-f97382e8d62d.lovableproject.com</string>
	</array>

	<!-- Deep link URL scheme: sita:// -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.lovable.sita-os</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sita</string>
			</array>
		</dict>
	</array>

	<!-- Permission usage strings — every permission Capacitor plugins may request -->
	<key>NSCameraUsageDescription</key>
	<string>SITA OS uses the camera to capture documents, receipts, and verification photos for your records.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>SITA OS uses the microphone for voice notes and Concierge voice commands.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>SITA OS accesses your photo library to attach images to records and reports.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>SITA OS saves generated reports and receipts to your photo library when you choose to export them.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>SITA OS uses Face ID to securely approve sensitive actions, sign approvals, and unlock confidential records.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>SITA OS uses your location to verify the context of approvals and tag receipts when you opt in.</string>
	<key>NSContactsUsageDescription</key>
	<string>SITA OS accesses contacts only when you explicitly invite a teammate or add a counterparty.</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>SITA OS does not track you across apps. This permission is requested only by third-party advisors you explicitly enable.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>SITA OS reads your calendar to coordinate scheduling with the Concierge advisor when you opt in.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>SITA OS uses Bluetooth to connect with trusted hardware authority devices for biometric approvals.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>SITA OS uses the local network to discover trusted SITA devices on the same Wi-Fi for cross-device handoff.</string>

	<!-- Capacitor: allow inline media playback -->
	<key>UIRequiresFullScreen</key>
	<false/>
	<key>UIWhitePointAdaptivityStyle</key>
	<string>UIWhitePointAdaptivityStyleStandard</string>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
