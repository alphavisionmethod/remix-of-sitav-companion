# ═══════════════════════════════════════════════════════
# SITA OS — Environment Configuration
# Copy to .env and fill in values for self-hosted deployment
# First-boot auto-generates secrets marked with [AUTO]
# ═══════════════════════════════════════════════════════

# ── Supabase / Database [AUTO] ───────────────────────────────
# These are auto-generated on first boot. Override only if needed.
POSTGRES_PASSWORD=
JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── Frontend ─────────────────────────────────────────────────
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=sita-self-hosted

# ── URLs ─────────────────────────────────────────────────────
SITE_URL=http://localhost:8080
API_EXTERNAL_URL=http://localhost:8000

# ── Brain Core ───────────────────────────────────────────────
BRAIN_CORE_URL=http://sita-brain-core:3001

# ── NATS JetStream ───────────────────────────────────────────
NATS_URL=nats://sita-nats:4222

# ── PostgREST ────────────────────────────────────────────────
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_MAX=500
RATE_LIMIT_WINDOW_MS=60000

# ── TLS / Traefik ───────────────────────────────────────────
# Email for Let's Encrypt ACME certificates
ACME_EMAIL=admin@sita.local
# Set to "true" to use self-signed certs (air-gapped deployments)
# First-boot generates self-signed certs automatically
# SITA_SELF_SIGNED_TLS=true

# ── Edge Functions Runtime ───────────────────────────────────
EDGE_FUNCTIONS_URL=http://sita-supabase-functions:9000

# ── Docker / Production ─────────────────────────────────────
NODE_ENV=production

# ── Optional: AI / LLM Configuration ────────────────────────
# For Lovable AI Gateway (cloud-hosted)
# LOVABLE_API_KEY=
# For local LLM fallback (self-hosted Ollama)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# ── Optional: Demo / Presentation Mode ───────────────────────
# Set to "true" to enable demo mode (bypasses auth, uses sample data)
# VITE_DEMO_MODE=true

# ── Optional: Custom Branding ────────────────────────────────
# VITE_APP_NAME=SITA OS
# VITE_APP_LOGO_URL=

# ── Optional: External Services ──────────────────────────────
# OPENAI_API_KEY=sk-...
# STRIPE_SECRET_KEY=sk_...
# RESEND_API_KEY=re_...

# ── Electron Desktop (optional) ─────────────────────────────
# SITA_UPDATE_URL=https://releases.sita.os/desktop
# SITA_CRASH_REPORT_URL=https://crashes.sita.os/submit
