# ═══════════════════════════════════════════════════════
# SITA OS — Environment Configuration
# Copy to .env and fill in values for self-hosted deployment
# ═══════════════════════════════════════════════════════

# ── Supabase / Database ──────────────────────────────────────────
POSTGRES_PASSWORD=change-me-to-a-secure-password
JWT_SECRET=change-me-to-a-256bit-secret-at-least-32-chars
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# ── Frontend ─────────────────────────────────────────────────────
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# ── URLs ─────────────────────────────────────────────────────────
SITE_URL=http://localhost:8080
API_EXTERNAL_URL=http://localhost:8000

# ── Brain Core ───────────────────────────────────────────────────
BRAIN_CORE_URL=http://localhost:3001

# ── NATS JetStream ───────────────────────────────────────────────
NATS_URL=nats://localhost:4222

# ── PostgREST ────────────────────────────────────────────────────
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions

# ── Optional: Demo / Presentation Mode ───────────────────────────
# Set to "true" to enable demo mode in production builds
# Bypasses auth requirements and uses sample data throughout
# VITE_DEMO_MODE=true

# ── Optional: Custom Branding ────────────────────────────────────
# VITE_APP_NAME=SITA OS
# VITE_APP_LOGO_URL=

# ── Optional: External Services ──────────────────────────────────
# OPENAI_API_KEY=sk-...
# STRIPE_SECRET_KEY=sk_...
# RESEND_API_KEY=re_...

# ── Edge Functions Runtime ───────────────────────────────────────
EDGE_FUNCTIONS_URL=http://sita-supabase-functions:9000

# ── Docker / Production ─────────────────────────────────────────
NODE_ENV=production
