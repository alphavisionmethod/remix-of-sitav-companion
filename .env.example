# ═══════════════════════════════════════════════════════
# SITA OS — Environment Configuration
# Copy to .env and fill in values for self-hosted deployment
# ═══════════════════════════════════════════════════════

# ── Supabase / Database ──────────────────────────────────────────
# CRITICAL: Change these before first boot! No default values.
POSTGRES_PASSWORD=
JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── Frontend ─────────────────────────────────────────────────────
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# ── URLs ─────────────────────────────────────────────────────────
SITE_URL=http://localhost:8080
API_EXTERNAL_URL=http://localhost:8000

# ── Brain Core ───────────────────────────────────────────────────
BRAIN_CORE_URL=http://localhost:3001

# ── NATS JetStream ───────────────────────────────────────────────
NATS_URL=nats://localhost:4222

# ── PostgREST ────────────────────────────────────────────────────
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions

# ── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_MAX=500
RATE_LIMIT_WINDOW_MS=60000

# ── TLS / Traefik ───────────────────────────────────────────────
# Email for Let's Encrypt ACME certificates
ACME_EMAIL=admin@sita.local
# Set to "true" to use self-signed certs (air-gapped deployments)
# SITA_SELF_SIGNED_TLS=true

# ── Optional: Demo / Presentation Mode ───────────────────────────
# Set to "true" to enable demo mode in production builds
# Bypasses auth requirements and uses sample data throughout
# VITE_DEMO_MODE=true

# ── Optional: Custom Branding ────────────────────────────────────
# VITE_APP_NAME=SITA OS
# VITE_APP_LOGO_URL=

# ── Optional: External Services ──────────────────────────────────
# OPENAI_API_KEY=sk-...
# STRIPE_SECRET_KEY=sk_...
# RESEND_API_KEY=re_...

# ── Edge Functions Runtime ───────────────────────────────────────
EDGE_FUNCTIONS_URL=http://sita-supabase-functions:9000

# ── Docker / Production ─────────────────────────────────────────
NODE_ENV=production

# ── Electron Desktop (optional) ─────────────────────────────────
# Update feed URL for OTA updates
# SITA_UPDATE_URL=https://releases.sita.os/desktop
# Crash report submission URL
# SITA_CRASH_REPORT_URL=https://crashes.sita.os/submit

# ── Code Signing (CI/CD only) ───────────────────────────────────
# macOS
# APPLE_IDENTITY=Developer ID Application: SITA (XXXXXXXXXX)
# APPLE_ID=dev@sita.os
# APPLE_PASSWORD=app-specific-password
# APPLE_TEAM_ID=XXXXXXXXXX
# Windows
# CSC_LINK=path/to/certificate.pfx
# CSC_KEY_PASSWORD=certificate-password
